# Port the Sasscout backend listens on
PORT=3001

# CORS allow-list (comma-separated origins). The backend NEVER uses a wildcard.
# Include every origin that will call the API (e.g. the frontend dev server).
CORS_ORIGIN=http://localhost:3311,http://localhost:3000,http://127.0.0.1:3000

# In-memory rate-limiting scaffold (process-local, reset on restart).
# Not a distributed limiter. See docs/backend-api.md.
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_MS=60000

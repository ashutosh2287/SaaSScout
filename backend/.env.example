# Port the Sasscout backend listens on
PORT=3001

# Interface the backend binds to. Leave UNSET for the node-server default
# (all interfaces). Set to 127.0.0.1 to bind loopback only, or 0.0.0.0 when a
# reverse proxy needs to reach it on a private network. Never required for
# public exposure — the reverse proxy is the public edge.
HOST=

# Trusted reverse-proxy boundary (STEP 31). Set to true ONLY when the backend
# is reachable exclusively through a controlled reverse proxy that strips and
# rewrites X-Forwarded-For (e.g. Caddy). When false/unset (default), the real
# client IP is the unspoofable socket peer, so a forged X-Forwarded-For cannot
# bypass the rate limiter. See docs/deployment.md for the full trust model.
TRUST_PROXY=false

# Strict-Transport-Security (STEP 31). Set to true ONLY for an HTTPS
# deployment behind the trusted proxy (operator confirmed). Never set during
# ordinary HTTP development, and never derived from request headers. When true,
# emits: Strict-Transport-Security: max-age=31536000.
HSTS_ENABLED=false

# CORS allow-list (comma-separated origins). The backend NEVER uses a wildcard.
# Include every origin that will call the API (e.g. the frontend dev server).
CORS_ORIGIN=http://localhost:3311,http://localhost:3000,http://127.0.0.1:3000

# In-memory rate-limiting scaffold (process-local, reset on restart).
# Not a distributed limiter. See docs/backend-api.md.
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_MS=60000

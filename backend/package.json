{
  "name": "sasscout-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Sasscout backend API",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test",
    "test": "node --import tsx --test \"test/**/*.test.ts\""
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@hono/node-server": "^1",
    "hono": "^4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^20",
    "eslint": "^9",
    "globals": "^17.12.0",
    "tsx": "^4",
    "typescript": "^5",
    "typescript-eslint": "^8.69.0"
  }
}
